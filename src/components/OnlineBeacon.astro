---
const apiBase = import.meta.env.PUBLIC_ANALYTICS_API_BASE ?? '';
---

<div class="online-beacon is-waiting" data-online-beacon data-api-base={apiBase} aria-live="polite">
  <span class="online-dot" aria-hidden="true"></span>
  <span data-online-label data-i18n="online.resting">小镇灯塔休息中</span>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-online-beacon]');
    if (!root) return;

    const label = root.querySelector('[data-online-label]');
    const apiBase = root.getAttribute('data-api-base');
    const isLocalHost = ['127.0.0.1', 'localhost'].includes(location.hostname);
    const api = apiBase
      ? apiBase.replace(/\/$/, '')
      : isLocalHost
        ? ''
        : `${location.origin}/api`;
    const heartbeatIntervalMs = 20000;
    let refreshTimer = null;

    const setWaiting = (text) => {
      root.classList.remove('is-live');
      root.classList.add('is-waiting');
      label.textContent = text;
    };

    const setLocalizedLive = (count) => {
      const lang = window.heartopiaI18n?.getLanguage?.() || 'zh';
      const suffix = window.heartopiaI18n?.ui?.[lang]?.['online.liveSuffix'] || '位镇民在线';
      root.classList.remove('is-waiting');
      root.classList.add('is-live');
      label.textContent = `${count} ${suffix}`;
    };

    if (!api) {
      setWaiting(window.heartopiaI18n?.ui?.[window.heartopiaI18n.getLanguage()]?.['online.resting'] || '小镇灯塔休息中');
      return;
    }

    const visitorKey = 'heartopia.visitorId';
    let visitorId = localStorage.getItem(visitorKey);
    if (!visitorId) {
      visitorId =
        window.crypto && window.crypto.randomUUID
          ? window.crypto.randomUUID()
          : `${Date.now()}-${Math.random().toString(36).slice(2)}`;
      localStorage.setItem(visitorKey, visitorId);
    }

    const heartbeat = async () => {
      try {
        const response = await fetch(`${api}/online/heartbeat`, {
          method: 'POST',
          cache: 'no-store',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ visitorId, path: location.pathname })
        });
        if (!response.ok) throw new Error('heartbeat request failed');
        const data = await response.json();
        const count = Number(data.online);
        if (Number.isFinite(count)) setLocalizedLive(count);
      } catch {
        setWaiting(window.heartopiaI18n?.ui?.[window.heartopiaI18n.getLanguage()]?.['online.connecting'] || '小镇灯塔连接中');
      }
    };

    const refresh = async () => {
      try {
        const response = await fetch(`${api}/online`, { cache: 'no-store' });
        if (!response.ok) throw new Error('online request failed');
        const data = await response.json();
        const count = Number(data.online);
        if (Number.isFinite(count)) setLocalizedLive(count);
      } catch {
        setWaiting(window.heartopiaI18n?.ui?.[window.heartopiaI18n.getLanguage()]?.['online.connecting'] || '小镇灯塔连接中');
      }
    };

    const runActiveLoop = () => {
      if (refreshTimer) clearInterval(refreshTimer);
      heartbeat();
      refreshTimer = setInterval(() => {
        if (document.visibilityState !== 'visible') return;
        heartbeat();
      }, heartbeatIntervalMs);
    };

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') {
        refresh();
        heartbeat();
      }
    });

    document.addEventListener('heartopia:language-applied', () => {
      if (root.classList.contains('is-live')) refresh();
    });

    runActiveLoop();
    refresh();
  })();
</script>
