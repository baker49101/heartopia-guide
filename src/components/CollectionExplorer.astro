---
import {
  Bird,
  BookOpen,
  Bug,
  CookingPot,
  Fish,
  Flower2,
  Heart,
  Leaf,
  Music,
  PawPrint,
  Sprout,
  Trophy,
  Users
} from '@lucide/astro';
import type { HeartopiaCollection } from '../data/heartopiaCollections';
import { SITE } from '../data/site';

type Props = {
  collection: HeartopiaCollection;
};

const { collection } = Astro.props;

const iconMap = {
  Bird,
  BookOpen,
  Bug,
  CookingPot,
  Fish,
  Flower2,
  Heart,
  Leaf,
  Music,
  PawPrint,
  Sprout,
  Trophy,
  Users
};

const Icon = iconMap[collection.icon as keyof typeof iconMap] ?? BookOpen;

const isEmpty = (value: unknown) =>
  value === null ||
  value === undefined ||
  value === '' ||
  (Array.isArray(value) && value.length === 0) ||
  (typeof value === 'object' && !Array.isArray(value) && Object.keys(value as Record<string, unknown>).length === 0);

const valueToText = (value: unknown): string => {
  if (isEmpty(value)) return '';
  if (Array.isArray(value)) return value.map(valueToText).filter(Boolean).join(', ');
  if (typeof value === 'object') return Object.values(value as Record<string, unknown>).map(valueToText).filter(Boolean).join(', ');
  return String(value);
};

const fieldText = (item: Record<string, any>, key: string) => valueToText(item[key]);
const itemAnchor = (item: Record<string, any>) => encodeURIComponent(String(item.id || item.name).toLowerCase());
const titleize = (value: string) =>
  value
    .split('-')
    .filter(Boolean)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(' ');
const englishLabels: Record<string, string> = {
  name: 'Name',
  location: 'Location',
  fishType: 'Type',
  shadowSize: 'Shadow Size',
  activity: 'Activity',
  fishingLevel: 'Fishing Lv.',
  catchingLevel: 'Catching Lv.',
  birdwatchLevel: 'Birdwatch Lv.',
  weather: 'Weather',
  timeOfDay: 'Time',
  prices: 'Prices',
  size: 'Size',
  crops: 'Crops',
  flowers: 'Flowers',
  growthTime: 'Growth Time',
  gardeningLevel: 'Gardening Lv.',
  seedPrice: 'Seed Price',
  sellPrice: 'Sell Price',
  buyPrice: 'Buy Price',
  energy: 'Energy',
  ingredients: 'Ingredients',
  cost: 'Cost',
  profit: 'Profit',
  unlock: 'Unlock',
  gifts: 'Gifts',
  shop: 'Shop',
  species: 'Species',
  favoriteFood: 'Favorite Food',
  favoriteWeather: 'Favorite Weather',
  ability: 'Ability',
  category: 'Category',
  difficulty: 'Difficulty',
  bpm: 'BPM',
  instrument: 'Instrument',
  composer: 'Composer',
  notes: 'Notes'
};
const englishLabel = (value: string) => englishLabels[value] ?? titleize(value);
const collectionKey = collection.slug === 'forageables' ? 'forage' : collection.slug;
const collectionTipsEn: Record<string, string> = {
  fish: 'Filter by weather and time first, then use shadow size to cut bad casts. Keep event fish in the tracker.',
  insects: 'Start with weather and time, then clear one location at a time to avoid chasing scattered spawns.',
  birds: 'Use the map to lock the right lake or sea area first, then wait for the weather window you need.',
  crops: 'Sort by growth time before planting so harvest windows and cooking prep stay in sync.',
  flowers: 'Group flowers by level and growth time when planning beds or gift runs.',
  forage: 'Bundle wood, ore, flowers, and herbs into one short route instead of clearing one material at a time.',
  recipes: 'Check unlocks and profit together so you do not spend rare ingredients on weak dishes.',
  characters: 'Keep gifts, shop access, and daily visit targets visible together to shorten town loops.',
  wildlife: 'Follow the habitat first, then narrow by favorite food or weather.',
  pets: 'Compare size, food, and ability together before you commit to a pet route.',
  achievements: 'Treat achievements as long routes: group easy overlapping goals before chasing the rare ones.',
  music: 'Sort by difficulty or instrument when building practice lists.',
  default: 'Search by location, condition, or use-case first, then narrow with the side filters.'
};
const countLabelsEn: Record<string, string> = {
  fish: 'fish entries',
  insects: 'insect entries',
  birds: 'bird entries',
  crops: 'crop entries',
  flowers: 'flower entries',
  forage: 'forage entries',
  recipes: 'recipe entries',
  characters: 'character entries',
  wildlife: 'wildlife entries',
  pets: 'pet entries',
  achievements: 'achievement entries',
  music: 'music entries'
};
const pageUrl = new URL(Astro.url.pathname, SITE.url).href;
const collectionTitleKey = `collection.${collectionKey}`;
const collectionDescriptionKey = `collection.desc.${collectionKey}`;
const collectionTipEn = collectionTipsEn[collectionKey] ?? collectionTipsEn.default;
const collectionCountLabelEn = countLabelsEn[collectionKey] ?? 'entries';

const facetValues = collection.facets.map((facet) => ({
  ...facet,
  values: Array.from(new Set(collection.items.map((item) => fieldText(item, facet.key)).filter(Boolean))).sort((a, b) =>
    a.localeCompare(b, 'zh-CN')
  )
}));

const starEntries = (value: unknown) => {
  if (!value || typeof value !== 'object' || Array.isArray(value)) return [];
  return Object.entries(value as Record<string, unknown>)
    .filter(([, amount]) => !isEmpty(amount))
    .sort(([a], [b]) => Number.parseInt(a, 10) - Number.parseInt(b, 10));
};

const starCount = (key: string) => Number.parseInt(key, 10) || 1;

const renderFieldValue = (item: Record<string, any>, field: HeartopiaCollection['fields'][number]) => {
  const value = item[field.key];
  if (isEmpty(value)) return '';
  if (field.prefix && (typeof value === 'number' || typeof value === 'string')) return `${field.prefix}${value}`;
  return valueToText(value);
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: collection.title,
  description: collection.description,
  url: pageUrl,
  numberOfItems: collection.items.length,
  itemListElement: collection.items.slice(0, 120).map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    url: `${pageUrl}#${itemAnchor(item)}`
  }))
};
---

<section class="collection-hero" data-pagefind-body>
  <div>
    <span class="eyebrow"><Icon size={16} aria-hidden="true" /> <span data-localize-en={collection.category === '收集' ? 'Collecting' : collection.category === '生活' ? 'Life' : collection.category === '居民' ? 'Residents' : 'Tools'}>{collection.category}</span></span>
    <h1 data-i18n={collectionTitleKey}>{collection.title}</h1>
    <p class="lead" data-i18n={collectionDescriptionKey}>{collection.description}</p>
  </div>
  <div class="collection-source-card">
    <strong>{collection.items.length}</strong>
    <span data-localize-en={collectionCountLabelEn}>{collection.countLabel}</span>
  </div>
</section>

<section class="section" data-pagefind-body>
  <div class="collection-toolbar" data-collection-explorer>
    <div class="collection-search">
      <label class="tag" for={`collection-search-${collection.slug}`} data-i18n="common.search">搜索</label>
      <input
        id={`collection-search-${collection.slug}`}
        class="filter-input"
        type="search"
        data-collection-query
        data-i18n-placeholder="database.search.placeholder"
        placeholder={`搜索${collection.navTitle}、地点、条件或用途`}
      />
    </div>
    <div class="collection-selects">
      {
        facetValues.map((facet) => (
          <label>
            <span data-localize-en={englishLabel(facet.key)}>{facet.label}</span>
            <select data-collection-facet={facet.key}>
              <option value="" data-localize-en={`All ${englishLabel(facet.key)}`}>全部{facet.label}</option>
              {facet.values.map((value) => <option value={value}>{value}</option>)}
            </select>
          </label>
        ))
      }
      <label>
        <span data-localize-en="Sort">排序</span>
        <select data-collection-sort>
          {collection.sortKeys.map((sort) => <option value={sort.key} data-localize-en={englishLabel(sort.key)}>{sort.label}</option>)}
        </select>
      </label>
    </div>
  </div>

  <div class="collection-note">
    <strong data-localize-en="Tips">使用建议</strong>
    <p data-localize-en={collectionTipEn}>{collection.tip}</p>
  </div>

  <div class="collection-count-line">
    <span data-collection-count>{collection.items.length}</span>
    <span data-localize-en="results">条结果</span>
  </div>

  <div class="item-card-grid" data-collection-list>
    {
      collection.items.map((item) => {
        const searchText = valueToText(item);
        const facetPayload = Object.fromEntries(collection.facets.map((facet) => [facet.key, fieldText(item, facet.key)]));
        const sortPayload = Object.fromEntries(collection.sortKeys.map((sort) => [sort.key, fieldText(item, sort.key)]));
        const englishName = titleize(String(item.id || item.name));
        return (
          <article
            class="item-card"
            id={itemAnchor(item)}
            data-collection-entry
            data-search={searchText}
            data-facets={JSON.stringify(facetPayload)}
            data-sort={JSON.stringify(sortPayload)}
          >
            <div class="item-card-head">
              <span class="collection-icon small"><Icon size={20} aria-hidden="true" /></span>
              <div>
                <h2 data-localize-en={englishName}>{item.name}</h2>
                <div class="caption-row">
                  {collection.fields.slice(0, 3).map((field) => {
                    const text = renderFieldValue(item, field);
                    return text ? <span class="tag"><span data-localize-en={englishLabel(field.key)}>{field.label}</span>: {text}</span> : null;
                  })}
                </div>
              </div>
            </div>

            <div class="item-field-list">
              {
                collection.fields.map((field) => {
                  const value = item[field.key];
                  if (isEmpty(value)) return null;
                  if (field.kind === 'stars') {
                    const rows = starEntries(value);
                    if (rows.length === 0) return null;
                    return (
                      <div class="item-field wide">
                        <span data-localize-en={englishLabel(field.key)}>{field.label}</span>
                        <div class="star-price-row">
                          {rows.map(([key, amount]) => (
                            <span>
                              <b>{'★'.repeat(starCount(key))}</b>
                              {String(amount)}
                            </span>
                          ))}
                        </div>
                      </div>
                    );
                  }
                  const text = renderFieldValue(item, field);
                  return (
                    <div class={`item-field ${field.kind === 'long' ? 'wide' : ''}`}>
                      <span data-localize-en={englishLabel(field.key)}>{field.label}</span>
                      <strong>{text}</strong>
                    </div>
                  );
                })
              }
            </div>

            <div class="item-card-footer">
              <span data-localize-en={item._meta?.confidence === 'high' ? 'Checked' : 'Reviewing'}>{item._meta?.confidence === 'high' ? '已核对' : '待复核'}</span>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

<script is:inline>
  (() => {
    const root = document.querySelector('[data-collection-explorer]');
    const list = document.querySelector('[data-collection-list]');
    if (!root || !list) return;

    const input = root.querySelector('[data-collection-query]');
    const facets = Array.from(root.querySelectorAll('[data-collection-facet]'));
    const sort = root.querySelector('[data-collection-sort]');
    const count = document.querySelector('[data-collection-count]');
    const cards = Array.from(list.querySelectorAll('[data-collection-entry]'));

    const compareText = (a, b) => {
      const numberA = Number(a);
      const numberB = Number(b);
      if (!Number.isNaN(numberA) && !Number.isNaN(numberB)) return numberA - numberB;
      return String(a).localeCompare(String(b), 'zh-CN', { numeric: true });
    };

    const update = () => {
      const keyword = input?.value.trim().toLowerCase() || '';
      const activeFacets = Object.fromEntries(
        facets.map((select) => [select.getAttribute('data-collection-facet'), select.value]).filter(([, value]) => value)
      );
      let visible = 0;
      cards.forEach((card) => {
        const search = (card.getAttribute('data-search') || '').toLowerCase();
        const facetValues = JSON.parse(card.getAttribute('data-facets') || '{}');
        const okSearch = !keyword || search.includes(keyword);
        const okFacets = Object.entries(activeFacets).every(([key, value]) => facetValues[key] === value);
        const show = okSearch && okFacets;
        card.toggleAttribute('hidden', !show);
        if (show) visible += 1;
      });

      const sortKey = sort?.value;
      if (sortKey) {
        cards
          .slice()
          .sort((a, b) => {
            const sortA = JSON.parse(a.getAttribute('data-sort') || '{}');
            const sortB = JSON.parse(b.getAttribute('data-sort') || '{}');
            return compareText(sortA[sortKey] || '', sortB[sortKey] || '');
          })
          .forEach((card) => list.appendChild(card));
      }
      if (count) count.textContent = String(visible);
    };

    input?.addEventListener('input', update);
    facets.forEach((select) => select.addEventListener('change', update));
    sort?.addEventListener('change', update);
    document.addEventListener('heartopia:language-applied', (event) => {
      const language = event.detail?.language;
      document.querySelectorAll('[data-localize-en]').forEach((node) => {
        if (!node.dataset.zhText) node.dataset.zhText = node.textContent || '';
        node.textContent = language === 'zh' ? node.dataset.zhText : node.getAttribute('data-localize-en');
      });
    });
    update();
  })();
</script>
