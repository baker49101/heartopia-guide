---
import { ArrowRight } from '@lucide/astro';

type Props = {
  title: string;
  description: string;
  href: string;
  label?: string;
  titleKey?: string;
  descriptionKey?: string;
  labelKey?: string;
};

const { title, description, href, label = 'Guide', titleKey, descriptionKey, labelKey } = Astro.props;
---

<a class="card" href={href}>
  <span class="tag" data-i18n={labelKey}>{label}</span>
  <h3 data-i18n={titleKey}>{title}</h3>
  <p data-i18n={descriptionKey}>{description}</p>
  <span class="card-meta">
    <span data-i18n="card.open">打开手账</span>
    <ArrowRight size={18} aria-hidden="true" />
  </span>
</a>
