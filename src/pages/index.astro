---
import { BookOpen, Database, Map, Search, Sprout } from '@lucide/astro';
import GuideCard from '../components/GuideCard.astro';
import { dailyChecklist, databaseSections, quickEntries } from '../data/home';
import { SITE } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section class="town-board" data-pagefind-body>
    <div class="hero-panel">
      <span class="eyebrow"><Sprout size={16} aria-hidden="true" /> Heartopia / 心动小镇</span>
      <h1>把小镇日常整理成一页温柔手账</h1>
      <p class="lead">
        查路线、看地图、补图鉴、追活动。用更短的路径，把每天的小镇生活安排得轻松一点。
      </p>
      <form class="hero-search" action="/search/" method="get">
        <Search size={20} aria-hidden="true" />
        <input name="q" type="search" placeholder="搜索鱼类、食谱、NPC、每日清单" />
        <button class="btn" type="submit">搜索</button>
      </form>
      <div class="hero-actions">
        <a class="btn" href="/guides/"><BookOpen size={18} aria-hidden="true" /> 看攻略</a>
        <a class="btn secondary" href="/database/"><Database size={18} aria-hidden="true" /> 查图鉴</a>
        <a class="btn secondary" href="/maps/"><Map size={18} aria-hidden="true" /> 看地图</a>
      </div>
    </div>
    <aside class="image-panel" aria-label="Heartopia 官方视觉">
      <img src={SITE.steamImage} alt="Heartopia 官方 Steam 截图：小镇街边的温暖生活场景" loading="eager" />
      <div class="image-caption">
        <strong>今日小镇速览</strong>
        <div class="caption-row">
          <span class="tag">攻略文章 6</span>
          <span class="tag">图鉴栏目 3</span>
          <span class="tag">地图区域 13</span>
        </div>
      </div>
    </aside>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <span class="eyebrow">Town Notes</span>
        <h2>先从这些入口开始</h2>
        <p>开荒、日常、钓鱼、地图、采集和说明都放在这里，想查什么直接进。</p>
      </div>
    </div>
    <div class="grid three">
      {quickEntries.map((entry) => <GuideCard {...entry} />)}
    </div>
  </section>

  <section class="section">
    <div class="soft-band">
      <div class="section-head">
        <div>
          <span class="eyebrow">Daily</span>
          <h2>每日小镇便签</h2>
          <p>上线后先看清单，再决定今天跑图、钓鱼还是拜访居民。</p>
        </div>
        <a class="btn secondary" href="/guides/daily-routine/">打开日常</a>
      </div>
      <ul class="checklist">
        {dailyChecklist.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <span class="eyebrow">Database</span>
        <h2>图鉴资料库</h2>
        <p>按鱼类、食谱、NPC 三类整理，适合快速查路线和用途。</p>
      </div>
    </div>
    <div class="grid three">
      {databaseSections.map((entry) => <GuideCard {...entry} />)}
    </div>
  </section>
</BaseLayout>
