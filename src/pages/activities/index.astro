---
import { CalendarDays } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="活动 | 心动小镇攻略手账" description="Heartopia / 心动小镇活动记录。">
  <section class="content-shell" data-pagefind-body>
    <span class="eyebrow"><CalendarDays size={16} aria-hidden="true" /> Events</span>
    <h1 data-i18n="activities.title">活动记录</h1>
    <p class="lead" data-i18n="activities.lead">整理官方公告、限时活动、兑换信息和版本变化，快速看重点。</p>
    <div class="soft-band">
      <h2 data-i18n="activities.quick.title">活动速查</h2>
      <ul class="checklist">
        <li data-i18n="activities.quick.item.1">活动名称、开始时间、结束时间</li>
        <li data-i18n="activities.quick.item.2">入口位置、任务流程、奖励列表</li>
        <li data-i18n="activities.quick.item.3">公告链接、奖励截图、注意事项</li>
        <li data-i18n="activities.quick.item.4">版本号与更新时间</li>
      </ul>
    </div>
  </section>
</BaseLayout>
