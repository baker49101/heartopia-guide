---
import GuideCard from '../../components/GuideCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const modules = import.meta.glob('./*.md', { eager: true });
const guides = Object.values(modules)
  .map((module: any) => ({
    ...module.frontmatter,
    href: module.url
  }))
  .sort((a, b) => String(b.updatedAt).localeCompare(String(a.updatedAt)));
---

<BaseLayout title="攻略 | 心动小镇攻略手账" description="Heartopia / 心动小镇攻略文章列表。">
  <section class="content-shell" data-pagefind-body>
    <span class="eyebrow">Guides</span>
    <h1>攻略手账</h1>
    <p class="lead">先放可维护的攻略框架，后续按版本和实测逐步补细节。</p>
  </section>
  <section class="section">
    <div class="grid three">
      {
        guides.map((guide) => (
          <GuideCard
            title={guide.title}
            description={guide.description}
            href={guide.href}
            label={guide.category}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
