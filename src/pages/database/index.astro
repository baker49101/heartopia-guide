---
import GuideCard from '../../components/GuideCard.astro';
import { databaseGroups } from '../../data/database';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="图鉴 | 心动小镇攻略手账" description="Heartopia / 心动小镇图鉴资料库。">
  <section class="content-shell" data-pagefind-body>
    <span class="eyebrow">Database</span>
    <h1>小镇图鉴资料库</h1>
    <p class="lead">鱼类、食谱、NPC 放在同一处，查路线和用途更省事。</p>
  </section>
  <section class="section">
    <div class="grid three">
      {
        databaseGroups.map((group) => (
          <GuideCard
            title={group.title}
            description={`${group.description} 当前条目：${group.count}`}
            href={group.href}
            label="图鉴"
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
