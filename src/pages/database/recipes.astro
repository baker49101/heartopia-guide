---
import DatabaseTable from '../../components/DatabaseTable.astro';
import { recipeEntries } from '../../data/database';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="食谱图鉴 | 心动小镇攻略手账" description="Heartopia / 心动小镇食谱图鉴。">
  <section class="content-shell" data-pagefind-body>
    <span class="eyebrow">Cooking</span>
    <h1>食谱图鉴</h1>
    <p class="lead">记录食材组合、解锁方式、用途和居民喜好，先以核验字段为准。</p>
    <DatabaseTable entries={recipeEntries} searchLabel="搜索食谱、食材、用途或解锁方式" />
  </section>
</BaseLayout>
