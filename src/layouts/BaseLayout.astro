---
import {
  Bird,
  BookOpen,
  Bug,
  CalendarDays,
  ChevronDown,
  ClipboardCheck,
  CookingPot,
  Database,
  Fish,
  Flower2,
  Heart,
  Home,
  Leaf,
  Map,
  Music,
  PawPrint,
  Search,
  Sprout,
  Trophy,
  Users
} from '@lucide/astro';
import AnalyticsClient from '../components/AnalyticsClient.astro';
import I18nClient from '../components/I18nClient.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import OnlineBeacon from '../components/OnlineBeacon.astro';
import { SITE, SOURCE_NOTICE } from '../data/site';
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
  robots?: string;
  image?: string;
  canonical?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
};

const {
  title = `${SITE.name} | Heartopia / 心动小镇攻略、图鉴与互动地图`,
  description = SITE.description,
  robots = 'index, follow, max-image-preview:large',
  image = SITE.steamImage,
  canonical,
  schema = []
} = Astro.props;
const pathname = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
const canonicalUrl = canonical ?? new URL(pathname, SITE.url).href;
const pageTitle = title === SITE.name ? `${SITE.name} | Heartopia / 心动小镇攻略、图鉴与互动地图` : title;

const breadcrumbLabelMap: Record<string, string> = {
  activities: '活动',
  admin: '后台',
  database: '图鉴',
  fish: '鱼类',
  npcs: '角色',
  recipes: '食谱',
  insects: '昆虫',
  birds: '鸟类',
  crops: '农作物',
  flowers: '花卉',
  forageables: '采集物',
  wildlife: '野生动物',
  pets: '宠物',
  achievements: '成就',
  music: '乐谱',
  characters: '角色',
  guides: '攻略',
  beginner: '新手第一天',
  'daily-routine': '每日清单',
  'fishing-route': '钓鱼路线',
  foraging: '采集整理',
  'map-routing': '地图跑图',
  'source-rules': '阅读说明',
  maps: '地图',
  search: '搜索',
  sources: '参考资料',
  tracker: '追踪器'
};
const segments = pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  { name: SITE.name, url: SITE.url },
  ...segments.map((segment, index) => {
    const path = `/${segments.slice(0, index + 1).join('/')}/`;
    return {
      name: breadcrumbLabelMap[segment] ?? segment,
      url: new URL(path, SITE.url).href
    };
  })
];
const extraSchema = Array.isArray(schema) ? schema : [schema];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      name: SITE.name,
      alternateName: ['Heartopia Guide', '心动小镇攻略'],
      url: SITE.url,
      inLanguage: SITE.language,
      description: SITE.description,
      potentialAction: {
        '@type': 'SearchAction',
        target: `${SITE.url}/search/?q={search_term_string}`,
        'query-input': 'required name=search_term_string'
      }
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description,
      isPartOf: { '@id': `${SITE.url}/#website` },
      inLanguage: SITE.language,
      dateModified: SITE.updatedAt
    },
    ...(breadcrumbItems.length > 1
      ? [
          {
            '@type': 'BreadcrumbList',
            '@id': `${canonicalUrl}#breadcrumb`,
            itemListElement: breadcrumbItems.map((item, index) => ({
              '@type': 'ListItem',
              position: index + 1,
              name: item.name,
              item: item.url
            }))
          }
        ]
      : []),
    ...extraSchema
  ]
};

const databaseMenu = [
  { href: '/database/achievements/', label: '成就', icon: Trophy },
  { href: '/database/fish/', label: '鱼类', icon: Fish },
  { href: '/database/insects/', label: '昆虫', icon: Bug },
  { href: '/database/birds/', label: '鸟类', icon: Bird },
  { href: '/database/crops/', label: '农作物', icon: Sprout },
  { href: '/database/flowers/', label: '花卉', icon: Flower2 },
  { href: '/database/forageables/', label: '采集物', icon: Leaf },
  { href: '/database/wildlife/', label: '野生动物', icon: PawPrint },
  { href: '/database/pets/', label: '宠物', icon: Heart },
  { href: '/database/music/', label: '乐谱', icon: Music },
  { href: '/database/recipes/', label: '食谱', icon: CookingPot },
  { href: '/database/characters/', label: '角色', icon: Users }
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={image} />
    <meta property="og:updated_time" content={SITE.updatedAt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content" data-i18n="common.skip">跳到正文</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true"><Home size={20} /></span>
          <span>
            <span data-i18n="site.name">{SITE.name}</span>
            <small data-i18n="site.subtitle">{SITE.englishName}</small>
          </span>
        </a>
        <nav class="main-nav" aria-label="主导航" data-i18n-aria="nav.aria">
          <a class="nav-link" href="/" aria-current={isCurrent('/') ? 'page' : undefined}>
            <Home size={17} aria-hidden="true" /> <span data-i18n="nav.home">首页</span>
          </a>
          <a class="nav-link" href="/guides/" aria-current={isCurrent('/guides/') ? 'page' : undefined}>
            <BookOpen size={17} aria-hidden="true" /> <span data-i18n="nav.guides">攻略</span>
          </a>
          <div class="nav-dropdown">
            <a class="nav-link" href="/database/" aria-current={isCurrent('/database/') ? 'page' : undefined}>
              <Database size={17} aria-hidden="true" /> <span data-i18n="nav.database">图鉴</span>
              <ChevronDown size={14} aria-hidden="true" />
            </a>
            <div class="nav-menu" aria-label="图鉴分类">
              {
                databaseMenu.map((item) => {
                  const Icon = item.icon;
                  return (
                    <a class="nav-menu-link" href={item.href}>
                      <Icon size={15} aria-hidden="true" />
                      <span>{item.label}</span>
                    </a>
                  );
                })
              }
            </div>
          </div>
          <a class="nav-link" href="/activities/" aria-current={isCurrent('/activities/') ? 'page' : undefined}>
            <CalendarDays size={17} aria-hidden="true" /> <span data-i18n="nav.activities">活动</span>
          </a>
          <a class="nav-link" href="/maps/" aria-current={isCurrent('/maps/') ? 'page' : undefined}>
            <Map size={17} aria-hidden="true" /> <span data-i18n="nav.maps">地图</span>
          </a>
          <a class="nav-link" href="/tracker/" aria-current={isCurrent('/tracker/') ? 'page' : undefined}>
            <ClipboardCheck size={17} aria-hidden="true" /> <span data-i18n="nav.tracker">追踪器</span>
          </a>
          <a class="nav-link" href="/search/" aria-current={isCurrent('/search/') ? 'page' : undefined}>
            <Search size={17} aria-hidden="true" /> <span data-i18n="nav.search">搜索</span>
          </a>
        </nav>
        <div class="header-actions">
          <OnlineBeacon />
          <LanguageSwitcher />
        </div>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p data-i18n="footer.notice">{SOURCE_NOTICE}</p>
        <div class="footer-links">
          <a href="/sources/" data-i18n="footer.sources">参考资料</a>
          {SITE.officialLinks.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>)}
        </div>
      </div>
    </footer>
    <I18nClient />
    <AnalyticsClient />
  </body>
</html>
