---
import {
  Bird,
  BookOpen,
  Bug,
  CalendarDays,
  ChevronDown,
  ClipboardCheck,
  CookingPot,
  Database,
  Fish,
  Flower2,
  Heart,
  Home,
  Leaf,
  Map,
  Music,
  PawPrint,
  Search,
  Sprout,
  Trophy,
  Users
} from '@lucide/astro';
import AnalyticsClient from '../components/AnalyticsClient.astro';
import I18nClient from '../components/I18nClient.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import OnlineBeacon from '../components/OnlineBeacon.astro';
import { SITE, SOURCE_NOTICE } from '../data/site';
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
  robots?: string;
};

const { title = SITE.name, description = SITE.description, robots } = Astro.props;
const pathname = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const databaseMenu = [
  { href: '/database/achievements/', label: '成就', icon: Trophy },
  { href: '/database/fish/', label: '鱼类', icon: Fish },
  { href: '/database/insects/', label: '昆虫', icon: Bug },
  { href: '/database/birds/', label: '鸟类', icon: Bird },
  { href: '/database/crops/', label: '农作物', icon: Sprout },
  { href: '/database/flowers/', label: '花卉', icon: Flower2 },
  { href: '/database/forageables/', label: '采集物', icon: Leaf },
  { href: '/database/wildlife/', label: '野生动物', icon: PawPrint },
  { href: '/database/pets/', label: '宠物', icon: Heart },
  { href: '/database/music/', label: '乐谱', icon: Music },
  { href: '/database/recipes/', label: '食谱', icon: CookingPot },
  { href: '/database/characters/', label: '角色', icon: Users }
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={SITE.steamImage} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content" data-i18n="common.skip">跳到正文</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true"><Home size={20} /></span>
          <span>
            <span data-i18n="site.name">{SITE.name}</span>
            <small data-i18n="site.subtitle">{SITE.englishName}</small>
          </span>
        </a>
        <nav class="main-nav" aria-label="主导航" data-i18n-aria="nav.aria">
          <a class="nav-link" href="/" aria-current={isCurrent('/') ? 'page' : undefined}>
            <Home size={17} aria-hidden="true" /> <span data-i18n="nav.home">首页</span>
          </a>
          <a class="nav-link" href="/guides/" aria-current={isCurrent('/guides/') ? 'page' : undefined}>
            <BookOpen size={17} aria-hidden="true" /> <span data-i18n="nav.guides">攻略</span>
          </a>
          <div class="nav-dropdown">
            <a class="nav-link" href="/database/" aria-current={isCurrent('/database/') ? 'page' : undefined}>
              <Database size={17} aria-hidden="true" /> <span data-i18n="nav.database">图鉴</span>
              <ChevronDown size={14} aria-hidden="true" />
            </a>
            <div class="nav-menu" aria-label="图鉴分类">
              {
                databaseMenu.map((item) => {
                  const Icon = item.icon;
                  return (
                    <a class="nav-menu-link" href={item.href}>
                      <Icon size={15} aria-hidden="true" />
                      <span>{item.label}</span>
                    </a>
                  );
                })
              }
            </div>
          </div>
          <a class="nav-link" href="/activities/" aria-current={isCurrent('/activities/') ? 'page' : undefined}>
            <CalendarDays size={17} aria-hidden="true" /> <span data-i18n="nav.activities">活动</span>
          </a>
          <a class="nav-link" href="/maps/" aria-current={isCurrent('/maps/') ? 'page' : undefined}>
            <Map size={17} aria-hidden="true" /> <span data-i18n="nav.maps">地图</span>
          </a>
          <a class="nav-link" href="/tracker/" aria-current={isCurrent('/tracker/') ? 'page' : undefined}>
            <ClipboardCheck size={17} aria-hidden="true" /> <span data-i18n="nav.tracker">追踪器</span>
          </a>
          <a class="nav-link" href="/search/" aria-current={isCurrent('/search/') ? 'page' : undefined}>
            <Search size={17} aria-hidden="true" /> <span data-i18n="nav.search">搜索</span>
          </a>
        </nav>
        <div class="header-actions">
          <OnlineBeacon />
          <LanguageSwitcher />
        </div>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p data-i18n="footer.notice">{SOURCE_NOTICE}</p>
        <div class="footer-links">
          <a href="/sources/" data-i18n="footer.sources">参考资料</a>
          {SITE.officialLinks.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>)}
        </div>
      </div>
    </footer>
    <I18nClient />
    <AnalyticsClient />
  </body>
</html>
