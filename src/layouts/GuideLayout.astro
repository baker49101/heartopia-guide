---
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
---

<BaseLayout title={`${frontmatter.title} | 心动小镇攻略手账`} description={frontmatter.description}>
  <div class="guide-shell">
    <article class="guide-article" data-pagefind-body>
      <span class="eyebrow">{frontmatter.category ?? '攻略'}</span>
      <h1>{frontmatter.title}</h1>
      <p class="lead">{frontmatter.description}</p>
      <div class="guide-meta">
        <span class="tag">更新：{frontmatter.updatedAt}</span>
        <span class="tag">参考：{frontmatter.source}</span>
      </div>
      <slot />
    </article>
  </div>
</BaseLayout>
