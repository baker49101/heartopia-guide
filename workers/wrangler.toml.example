name = "heartopia-analytics"
main = "analytics-worker.js"
compatibility_date = "2026-05-12"

# 推荐直接走主站同域路径
# routes = [
#   { pattern = "xdxz.qichuan.xyz/api/*", zone_name = "qichuan.xyz" }
# ]

[[d1_databases]]
binding = "DB"
database_name = "heartopia_analytics"
database_id = "replace-with-your-d1-database-id"
